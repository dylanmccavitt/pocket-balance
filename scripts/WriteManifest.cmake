# Called only after a plugin target finishes building.
file(GLOB_RECURSE SOURCE_FILES RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/Source/*" "${SOURCE_DIR}/Tests/*" "${SOURCE_DIR}/FLStudio/*")
list(FILTER SOURCE_FILES EXCLUDE REGEX "(__pycache__/|\\.pyc$)")
list(APPEND SOURCE_FILES CMakeLists.txt)
list(SORT SOURCE_FILES)
set(SOURCE_SIGNATURE "")
foreach(FILE IN LISTS SOURCE_FILES)
  if(NOT IS_DIRECTORY "${SOURCE_DIR}/${FILE}")
    file(SHA256 "${SOURCE_DIR}/${FILE}" HASH)
    string(APPEND SOURCE_SIGNATURE "${FILE}:${HASH}\n")
  endif()
endforeach()
string(SHA256 SOURCE_HASH "${SOURCE_SIGNATURE}")
file(GLOB_RECURSE BUNDLE_FILES RELATIVE "${BUNDLE_PATH}" "${BUNDLE_PATH}/*")
list(SORT BUNDLE_FILES)
set(BUNDLE_SIGNATURE "")
foreach(FILE IN LISTS BUNDLE_FILES)
  if(NOT IS_DIRECTORY "${BUNDLE_PATH}/${FILE}")
    file(SHA256 "${BUNDLE_PATH}/${FILE}" HASH)
    string(APPEND BUNDLE_SIGNATURE "${FILE}:${HASH}\n")
  endif()
endforeach()
string(SHA256 BUNDLE_HASH "${BUNDLE_SIGNATURE}")
file(WRITE "${OUTPUT}" "{\"version\":\"${VERSION}\",\"source_sha256\":\"${SOURCE_HASH}\",\"bundle_sha256\":\"${BUNDLE_HASH}\"}\n")
